{
  "name": "pi-codemode-expo",
  "version": "0.2.0",
  "description": "Native Expo QuickJS adapter for Pi Codemode and Pi Durable 1.3.0",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metro": {
      "types": "./dist/metro.d.ts",
      "default": "./dist/metro.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/native-channel.md",
    "docs/verification.md",
    "examples/expo",
    "docs/evidence/ios-adapter.png"
  ],
  "scripts": {
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "node scripts/generate-bootstrap.mjs --check && vitest run",
    "prepack": "npm run build",
    "test:protocol": "vitest run tests/contract.test.ts tests/bootstrap.test.ts tests/native-channel.test.ts tests/metro.test.ts",
    "check:package": "node scripts/check-package.mjs",
    "generate": "node scripts/generate-bootstrap.mjs",
    "test:release": "node --test scripts/validate-release.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-codemode": "1.3.0",
    "expo-quickjs": "0.1.0"
  },
  "peerDependenciesMeta": {
    "expo-quickjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "typebox": "1.3.27",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/chord": "1.3.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugarforever/pi-codemode-expo.git"
  },
  "homepage": "https://github.com/sugarforever/pi-codemode-expo#readme",
  "bugs": {
    "url": "https://github.com/sugarforever/pi-codemode-expo/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
